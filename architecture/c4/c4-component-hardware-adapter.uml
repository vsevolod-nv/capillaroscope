@startuml capillaroscope-hardware-adapter-component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C4 Component diagram: Hardware adapter

Container(application, "Application", "Python", "Координирует сценарии исследования и команды устройству.")
Container(mock_microcontroller, "Mock Microcontroller", "Python / simulator", "Имитирует камеру и подсветку во время разработки.")
System_Ext(device, "Device", "Подсветка капилляроскопа.")
System_Ext(camera, "Camera", "Камера.")

Container_Boundary(hardware_adapter, "Hardware adapter") {
    Component(camera_base, "CameraBase", "Interface", "Описывает общий интерфейс работы с камерой, включает в себя cfg.")
    Component(mindvision, "MindVision", "Python", "Модуль реальной камеры")
    Component(mock_camera, "MockCamera", "Python", "Имитирует камеру во время разработки.")

    Component(device_base, "DeviceBase", "Interface", "Описывает общий интерфейс работы платы со светодиодами.")
    Component(serial_capillaroscope_device, "Device", "Python", "Модуль платы со светодиодами")
    Component(mock_device, "MockDevice", "Python", "Имитирует микроконтроллер")
}

Rel(application, camera_base, "Вызывает интерфейс камеры")
Rel(camera_base, application, "Возвращает кадры, статус и ошибки")
Rel(application, device_base, "Вызывает интерфейс устройства")
Rel(device_base, application, "Возвращает статус подсветки, фокуса и ошибки")

Rel(mindvision, camera_base, "Реализует")
Rel(mock_camera, camera_base, "Реализует")
Rel(serial_capillaroscope_device, device_base, "Реализует")
Rel(mock_device, device_base, "Реализует")

Rel(mindvision, camera, "Получает изображение и статус камеры")
Rel(serial_capillaroscope_device, mock_microcontroller, "Передает команды и получает статусы")
Rel(mock_microcontroller, device, "Управляет светодиодом")
Rel(mock_microcontroller, camera, "Управляет камерой")

@enduml
