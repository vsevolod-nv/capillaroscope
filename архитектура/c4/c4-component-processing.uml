@startuml capillaroscope-processing-component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C4 Component diagram: Processing

Container(application, "Application", "Запускает обработку изображений и получает результаты анализа.")
ContainerDb(storage, "Storage", "Postgres/etc", "Хранит снимки, видео, настройки и результаты исследований.")

Container_Boundary(processing, "Processing") {
    Component(image_quality, "Image quality", "Python", "Оценивает качество изображения и пригодность кадра для анализа.")
    Component(vessel_segmentation, "Vessel segmentation", "Python", "Выделяет область сосудов на изображении.")
    Component(oximetry, "Oximetry", "Python", "Рассчитывает карту оксигенации и итоговые метрики.")
}

Rel(application, image_quality, "Передает кадры для проверки качества")
Rel(application, vessel_segmentation, "Передает кадры для сегментации")
Rel(application, oximetry, "Запускает расчет метрик")

Rel(image_quality, vessel_segmentation, "Передает оценку качества кадра")
Rel(vessel_segmentation, oximetry, "Передает маску сосудов")

Rel(image_quality, storage, "Сохраняет оценку качества")
Rel(vessel_segmentation, storage, "Сохраняет маску сосудов")
Rel(oximetry, storage, "Сохраняет карту оксигенации и метрики")

@enduml
